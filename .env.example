# Devin Automations configuration.
#
# Three ways to supply secrets — pick one, never commit real values:
#   1. .env file      cp .env.example .env and fill it in (docker compose reads it automatically).
#   2. Shell env      DEVIN_API_KEY=... GITHUB_TOKEN=... docker compose up   (nothing on disk)
#   3. Secret files   mount the secret and set DEVIN_API_KEY_FILE=/run/secrets/devin_api_key
#                     (also GITHUB_TOKEN_FILE, GITHUB_WEBHOOK_SECRET_FILE) — Docker/Kubernetes style.
#      The *_FILE variant wins over the plain variable when both are set.

# ---------- Devin API ----------
DEVIN_API_BASE=https://api.devin.ai/v3
# Service-user API key (cog_...). Leave empty when MOCK_DEVIN=true.
DEVIN_API_KEY=
# Organization id from your Devin settings (org-...). Never hardcoded in the app.
DEVIN_ORG_ID=

# ---------- GitHub ----------
# Fine-grained PAT with issues:write on the target repo. Empty = comments are logged, not posted.
GITHUB_TOKEN=
# Shared secret configured on the webhook; empty = unsigned webhooks accepted (dev only).
GITHUB_WEBHOOK_SECRET=
# Repository whose issues get remediated, and the branch PRs target.
TARGET_REPO=priyalwalpita/superset
BASE_BRANCH=master
# Applying this label to an issue triggers a remediation session.
TRIGGER_LABEL=devin:remediate

# ---------- Governance ----------
# Hard ACU cap per session, and how many sessions may run at once.
MAX_ACU_LIMIT=5
MAX_CONCURRENT_SESSIONS=2
# Poller cadence; the dashboard heartbeat turns red past 3x this value.
POLL_INTERVAL_SECONDS=20
# Used only for cost estimation on the dashboard/metrics.
ACU_COST_USD=2.00
# Ask Devin to review each PR it opens (best effort, non-fatal).
ENABLE_DEVIN_REVIEW=false
# Skip the human approval gate inside the session.
BYPASS_APPROVAL=true

# ---------- Simulation ----------
# true = no Devin API calls at all; sessions are simulated in-process (keyless demo).
MOCK_DEVIN=true
DB_PATH=data/automations.db
# Only used by the optional `smee` compose profile for local webhook tunnelling.
SMEE_URL=
